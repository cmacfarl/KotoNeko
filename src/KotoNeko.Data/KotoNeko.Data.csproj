<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\KotoNeko.Core\KotoNeko.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The drafted grammar list, read by GrammarList.Drafted(). -->
    <EmbeddedResource Include="Grammar\grammar-list.json" LogicalName="KotoNeko.Data.Grammar.grammar-list.json" />
    <!-- Unlabelled candidates for the grading test set, read by GradingTestSet.Candidates(). -->
    <EmbeddedResource Include="Grammar\grading-candidates.json" LogicalName="KotoNeko.Data.Grammar.grading-candidates.json" />
    <!-- How each candidate was drafted: one pre-labelling vote, never shown while labelling. -->
    <EmbeddedResource Include="Grammar\grading-candidates-intent.json" LogicalName="KotoNeko.Data.Grammar.grading-candidates-intent.json" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>

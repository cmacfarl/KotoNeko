@inject ReviewService ReviewService
@inject IJSRuntime JS
@implements IAsyncDisposable

@if (Session is null)
{
    <div class="kn-session-done">
        <p class="kn-empty">Nothing to do here right now.</p>
        <a class="kn-btn kn-btn-primary" href="/">Back to dashboard</a>
    </div>
}
else if (Session.IsComplete)
{
    <div class="kn-session-done">
        <div class="big">🎉</div>
        <h1>@(Session.Kind == SessionKind.Lesson ? "Lessons complete!" : "Reviews complete!")</h1>
        <p>
            @Session.TotalCards item@(Session.TotalCards == 1 ? "" : "s") finished
            @if (Session.Kind == SessionKind.Review)
            {
                <span>— <span style="color:var(--kn-correct-dark);font-weight:600">@Session.CorrectCount correct</span>,
                <span style="color:var(--kn-incorrect-dark);font-weight:600">@Session.IncorrectCount with mistakes</span></span>
            }
        </p>
        <a class="kn-btn kn-btn-primary" href="/">Back to dashboard</a>
    </div>
}
else
{
    ReviewCard card = _displayCard;
    ReviewQuestion q = _displayQuestion;
    // Only vocabulary cards exist so far; other kinds will get their own prompt.
    Vocabulary vocab = (Vocabulary)card.Item;

    <div class="kn-quiz">
        <div class="kn-quiz-header">
            <button class="kn-quiz-exit" title="End session" @onclick="ExitAsync">✕</button>
            <div class="kn-quiz-progress">
                <div class="kn-quiz-progress-fill" style="width:@(ProgressPercent)%"></div>
            </div>
            <div class="kn-quiz-counts">
                <span class="ok">@Session.FinishedCards</span> / @Session.TotalCards done
            </div>
        </div>

        <div class="kn-prompt @PromptClass(q)">
            <div class="kn-prompt-main">
                @if (q.Type == QuestionType.Production) {
                    <div class="kn-prompt-production-text">@q.Prompt</div>
                    <div class="kn-prompt-type"><span class="strong">Japanese reading</span></div>
                } else if (q.Type == QuestionType.Listening) {
                    // Nothing written is shown until the answer is in: the sound is the prompt.
                    @if (_mode == Mode.AwaitingInput) {
                        <button class="kn-listen-btn" title="Play again (Tab)" @onclick="ReplayAsync">🔊</button>
                    } else {
                        <div class="kn-prompt-word">
                            @if (vocab.HasKanji) {
                                <ruby>@vocab.Japanese<rt>@vocab.Reading</rt></ruby>
                            } else {
                                @vocab.Japanese
                            }
                        </div>
                    }
                    <div class="kn-prompt-type"><span class="strong">Listening</span> · what does it mean?</div>
                } else {
                    <div class="kn-prompt-word">
                        @if (vocab.ShowsFurigana) {
                            <ruby>@vocab.Japanese<rt>@vocab.Reading</rt></ruby>
                        } else {
                            @vocab.Japanese
                        }
                    </div>
                    <div class="kn-prompt-type">
                        <span class="strong">@q.Prompt</span>
                    </div>
                }
            </div>
            
            @if (_mode == Mode.ShowingResult || _mode == Mode.PlayingAudio) {
                <div class="kn-extra">
                    @if (q.Type == QuestionType.Reading) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp-reading">@vocab.Reading</span></div>
                    } else if (q.Type == QuestionType.Conjugation) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp-reading">@_lastCorrectAnswer</span></div>
                    } else if (q.Type == QuestionType.Meaning) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp">@vocab.MeaningsDisplay</span></div>
                    } else if (q.Type == QuestionType.Listening) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp">@vocab.MeaningsDisplay</span></div>
                        @if (_heardHomophone is { } h) {
                            <div class="kn-extra-row kn-homophone">
                                Same sound: you heard <span class="kn-jp">@h.Japanese</span> (@h.PrimaryMeaning).
                                This one was <span class="kn-jp">@vocab.Japanese</span>.
                            </div>
                        }
                    } else if (q.Type == QuestionType.Production) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp-reading">
                            @if (vocab.HasKanji) {
                                <ruby>@vocab.Japanese<rt>@vocab.Reading</rt></ruby>
                            } else {
                                @vocab.Japanese
                            }
                        </span></div>
                    }

                    @if (!string.IsNullOrWhiteSpace(vocab.ContextSentence)) {
                        <div class="kn-extra-row">@vocab.ContextSentence</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(vocab.Memo)) {
                        <div class="kn-extra-row">@vocab.Memo</div>
                    }
                </div>
            } else {
                <div class="kn-extra">
                    @if (q.Type == QuestionType.Reading || q.Type == QuestionType.Production) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp"></span></div>
                    } else if (q.Type == QuestionType.Conjugation) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp"></span></div>
                    } else if (q.Type is QuestionType.Meaning or QuestionType.Listening) {
                        <div class="kn-extra-row"><span class="kn-extra-label"></span> <span class="kn-jp"></span></div>
                    }
                </div>
            }
        </div>
        
        <div class="kn-answer @AnswerStateClass @(_shake ? "kn-shake" : "")">
            <input @ref="_inputRef"
                   type="text"
                   value="@_input"
                   data-kn-convert="@(IsKana(q.Type) ? "true" : "false")"
                   data-kn-replay="@(q.Type == QuestionType.Listening && _mode == Mode.AwaitingInput ? "true" : "false")"
                   placeholder="@Placeholder(q)"
                   autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false"
                   readonly="@(_mode == Mode.ShowingResult)"
                   @onkeydown="OnKeyDown" />
        </div>

        <div class="kn-answer-footer">
            <button class="kn-undo-btn" disabled="@(!CanUndo)" @onclick="UndoAsync" title="Undo last answer (fix a typo)">
                ↶ Undo
            </button>
            @if (_mode == Mode.ShowingResult && q.Type == QuestionType.Conjugation)
            {
                <button class="kn-conj-help-btn" @onclick="ToggleHelpPanel" title="Conjugation grammar help (?)">? Help</button>
            }
            @if (q.Type == QuestionType.Listening)
            {
                <span class="kn-hint">Tab plays it again</span>
            }
        </div>

        @if (_showConjHelp && q.Type == QuestionType.Conjugation && q.Form.HasValue && q.Polarity.HasValue)
        {
            <div class="kn-conj-help-overlay" @ref="_helpPanelRef" tabindex="-1"
                 @onkeydown="OnHelpPanelKeyDown" @onclick="CloseHelpPanel">
                <div class="kn-conj-help-panel" @onclick:stopPropagation="true">
                    <ConjugationHelpPanel
                        Form="q.Form.Value"
                        Polarity="q.Polarity.Value"
                        HighlightClass="vocab.VerbClass"
                        OnDismiss="CloseHelpPanel" />
                </div>
            </div>
        }

    </div>
}

@code {
    [Parameter] public ReviewSession? Session { get; set; }

    /// <summary>Invoked when the user exits or the session completes (after persist).</summary>
    [Parameter] public EventCallback OnExit { get; set; }

    private enum Mode { AwaitingInput, PlayingAudio, ShowingResult }

    private Mode _mode = Mode.AwaitingInput;
    private string _input = string.Empty;
    private string answer = string.Empty;
    private bool needsClear = false;
    private bool _shake;
    private string? _closeHint;
    private AnswerJudgment _lastJudgment;
    private string? _lastCorrectAnswer;
    private bool _focusQueued;
    private bool _persisted;
    private ReviewCard? _displayCard;
    private ReviewQuestion? _displayQuestion;
    
    private bool _showConjHelp;
    private bool _focusPanelQueued;
    private ElementReference _inputRef;
    private ElementReference _helpPanelRef;
    private DotNetObjectReference<SessionRunner>? _dotNetRef;
    private bool _kanaAttached;
    private string _lastTyped = string.Empty;
    private bool _autoPlayQueued;
    private Homophone? _heardHomophone;

    // Undo applies only to the answer whose result is on screen: not while its
    // audio is still playing, and not once the user has moved on (which commits it).
    private bool CanUndo => _mode == Mode.ShowingResult && Session is { CanUndo: true };

    private int ProgressPercent =>
        Session is null || Session.TotalCards == 0
            ? 0
            : (int)(100.0 * Session.FinishedCards / Session.TotalCards);

    protected override void OnParametersSet()
    {
        if (Session is not null && Session.CurrentQuestion is not null) {
            _displayCard = Session.CurrentCard;
            _displayQuestion = Session.CurrentQuestion;
            _focusQueued = true;
            QueueListeningAutoPlay();
        }
    }

    // A listening question starts by playing its word once it is on screen.
    private void QueueListeningAutoPlay() =>
        _autoPlayQueued = _displayQuestion?.Type == QuestionType.Listening;

    [JSInvokable]
    public Task OnReplayKey() => ReplayAsync();

    private async Task ReplayAsync()
    {
        if (_mode != Mode.AwaitingInput || _displayQuestion?.Type != QuestionType.Listening
            || _displayCard?.Item is not Vocabulary vocab) {
            return;
        }

        try {
            await JS.InvokeVoidAsync("kotoneko.playAudio", $"/api/vocab/{vocab.Id}/audio/word");
        } catch {
            Console.WriteLine("Failed to play listening audio for " + vocab.Reading);
        }
        _focusQueued = true;
    }

    // Called from JS (kotoneko.kanaInput) after it has converted + displayed the
    // value in the browser. We only mirror it into component state; we do NOT
    // re-render the input here, so the server never pushes the value back and
    // races the user's typing. (No StateHasChanged: JSInvokable calls don't
    // auto-render, which is exactly what we want.)
    [JSInvokable]
    public Task OnKanaInput(string converted)
    {
        if (_mode != Mode.ShowingResult) {
            answer = converted;
        }
        return Task.CompletedTask;
    }

    private async Task OnKeyDown(KeyboardEventArgs e) {
        if (_mode == Mode.PlayingAudio) return;

        if (e.Key == "Escape") {
            if (_showConjHelp) CloseHelpPanel();
            return;
        }

        if (e.Key == "?") {
            if (_mode == Mode.ShowingResult && _displayQuestion?.Type == QuestionType.Conjugation)
                ToggleHelpPanel();
            return;
        }

        if (e.Key != "Enter") return;

        if (_mode == Mode.ShowingResult) {
            if (_showConjHelp) { CloseHelpPanel(); return; }
            await AdvanceAsync();
            return;
        }

        await SubmitAsync();
    }

    private async Task OnHelpPanelKeyDown(KeyboardEventArgs e) {
        if (e.Key is "Escape" or "?") {
            CloseHelpPanel();
        } else if (e.Key == "Enter") {
            CloseHelpPanel();
            await AdvanceAsync();
        }
    }

    private void ToggleHelpPanel() {
        _showConjHelp = !_showConjHelp;
        if (_showConjHelp) _focusPanelQueued = true;
        else _focusQueued = true;
    }

    private void CloseHelpPanel() {
        _showConjHelp = false;
        _focusQueued = true;
    }

    private async Task SubmitAsync() {
        if (Session is null || Session.CurrentQuestion is null) {
            return;
        }

        if (string.IsNullOrWhiteSpace(answer)) {
            await ShakeAsync("Type an answer.");
            return;
        }

        // The browser already converted kana answers; re-run the C# converter as
        // the authoritative grading input (idempotent on kana, and a safety net
        // against any client/server drift).
        ReviewQuestion question = Session.CurrentQuestion;
        // _input = IsKana(question.Type) ? RomajiConverter.ToHiragana(_input) : _input;

        SubmitOutcome outcome = Session.Submit(answer);

        if (outcome.Judgment == AnswerJudgment.CloseTryAgain) {
            await ShakeAsync("Hmm, not quite — check your input and try again.");
            return;
        }

        // Committed answer: remember the typed text so Undo can restore it.
        _lastTyped = answer;
        _closeHint = null;
        _lastJudgment = outcome.Judgment;
        _lastCorrectAnswer = outcome.CorrectAnswer;
        _heardHomophone = outcome.Judgment == AnswerJudgment.Correct ? question.MatchedHomophone(answer) : null;
        _mode = Mode.PlayingAudio;

        // Listening answers replay the word either way: hearing it again while
        // seeing it written is the point of the question.
        bool playAudio = outcome.Judgment == AnswerJudgment.Correct || question.Type == QuestionType.Listening;
        if (playAudio && _displayCard?.Item is Vocabulary vocab) {

            StateHasChanged();
            await Task.Yield();

            try {
                if (question.Type == QuestionType.Conjugation && question.ConjugationId is int conjId) {
                    await JS.InvokeVoidAsync("kotoneko.playAudio", $"/api/conjugation/{conjId}/audio");
                } else if (vocab.HasWordAudio) {
                    Console.WriteLine("Starting word audio");
                    await JS.InvokeVoidAsync("kotoneko.playAudio", $"/api/vocab/{vocab.Id}/audio/word");
                    Console.WriteLine("Finished word audio");
                    if (vocab.HasSentenceAudio) {
                        await Task.Delay(800);
                        Console.WriteLine("Starting sentence audio");
                        await JS.InvokeVoidAsync("kotoneko.playAudio", $"/api/vocab/{vocab.Id}/audio/sentence");
                        Console.WriteLine("Finished sentence audio");
                    }
                }
            } catch {
                Console.WriteLine("Failed to play audio for " + vocab.Reading);
            }
        }
        _mode = Mode.ShowingResult;
    }

    private async Task AdvanceAsync() {
        // Moving on makes the shown answer permanent: commit it (which ends its
        // undo window) and persist any card it finished, so progress survives a
        // crash or a closed tab.
        ReviewSession.PendingResults? results = Session?.CommitPendingResults();

        _mode = Mode.AwaitingInput;
        _input = string.Empty;
        answer = string.Empty;
        _closeHint = null;
        _showConjHelp = false;
        _focusQueued = true;
        _displayCard = Session?.CurrentCard;
        _displayQuestion = Session?.CurrentQuestion;
        _heardHomophone = null;
        needsClear = true;
        QueueListeningAutoPlay();

        // The next question renders as soon as this yields; the write happens behind it.
        if (results is { } r && (r.SrsItems.Count > 0 || r.Logs.Count > 0)) {
            await ReviewService.PersistAsync(r);
        }
    }

    private async Task UndoAsync() {
        if (Session is null || !CanUndo) {
            return;
        }

        Session.Undo();
        _input = _lastTyped;
        _displayCard = Session.CurrentCard;
        _displayQuestion = Session.CurrentQuestion;
        _heardHomophone = null;
        _mode = Mode.AwaitingInput;
        _closeHint = "Undone — fix your answer and submit again.";
        _focusQueued = true;
        await Task.CompletedTask;
    }

    private async Task ShakeAsync(string hint) {
        _closeHint = hint;
        _shake = true;
        StateHasChanged();
        await Task.Delay(360);
        _shake = false;
    }

    private async Task ExitAsync() {
        await PersistAsync();
        await OnExit.InvokeAsync();
    }

    private async Task PersistAsync() {
        if (_persisted || Session is null) {
            return;
        }

        _persisted = true;
        await ReviewService.PersistAsync(Session.CommitPendingResults());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Persist automatically once the session is finished.
        if (Session is not null && Session.IsComplete && !_persisted) {
            await PersistAsync();
        }

        // Wire the answer box up to the client-side kana converter once it exists.
        // The same <input> element is reused across questions; the per-question
        // data-kn-convert attribute decides whether to convert.
        if (!_kanaAttached && Session?.CurrentQuestion is not null) {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            try {
                await JS.InvokeVoidAsync("kotoneko.kanaInput.attach", _inputRef, _dotNetRef,
                    new { interceptKeys = false, replayKey = true });
                _kanaAttached = true;
            } catch (JSException) {
                // ignore; will retry on a later render
            }
        }
        
        if (needsClear) {
            needsClear = false;
            try {
                // Force the DOM to actually be empty
                await JS.InvokeVoidAsync("kotoneko.kanaInput.setValue", _inputRef, "");
            }
            catch { /* ignore */ }
        }
        
        if (_focusPanelQueued) {
            _focusPanelQueued = false;
            try {
                await JS.InvokeVoidAsync("kotoneko.focus", _helpPanelRef);
            } catch (JSException) {
                // ignore focus failures
            }
        }

        if (_focusQueued) {
            _focusQueued = false;
            try {
                await JS.InvokeVoidAsync("kotoneko.focusSelect", _inputRef);
            } catch (JSException) {
                // ignore focus failures
            }
        }

        // Not awaited: the user can start typing while the word plays.
        if (_autoPlayQueued) {
            _autoPlayQueued = false;
            _ = ReplayAsync();
        }
    }

    private static bool IsKana(QuestionType type) =>
        type is QuestionType.Reading or QuestionType.Conjugation or QuestionType.Production;

    private static string PromptClass(ReviewQuestion q) => q.Type switch
    {
        QuestionType.Meaning    => "kn-prompt-meaning",
        QuestionType.Reading    => "kn-prompt-reading",
        QuestionType.Production => "kn-prompt-production",
        QuestionType.Conjugation => "kn-prompt-conjugation",
        QuestionType.Listening  => "kn-prompt-listening",
        _ => "kn-prompt-vocab",
    };

    private string AnswerStateClass => (_mode == Mode.ShowingResult || _mode == Mode.PlayingAudio)
        ? (_lastJudgment == AnswerJudgment.Correct ? "correct" : "incorrect")
        : string.Empty;

    private static string Placeholder(ReviewQuestion q) => q.Type switch
    {
        QuestionType.Meaning    => "Meaning",
        QuestionType.Reading    => "Reading",
        QuestionType.Production => "Reading",
        QuestionType.Conjugation => "Conjugated form",
        QuestionType.Listening  => "Meaning of what you heard",
        _ => "",
    };

    public async ValueTask DisposeAsync()
    {
        // Persist progress if the component is torn down mid-session.
        await PersistAsync();

        if (_kanaAttached)
        {
            try
            {
                await JS.InvokeVoidAsync("kotoneko.kanaInput.detach", _inputRef);
            }
            catch (JSException)
            {
                // circuit may already be gone
            }
            catch (InvalidOperationException)
            {
                // no JS runtime
            }
        }
        _dotNetRef?.Dispose();
    }
}

@page "/grammar-reviews"
@implements IDisposable
@using KotoNeko.Core.Llm
@using KotoNeko.Core.Review
@using KotoNeko.Core.Srs
@inject GrammarReviewService Reviews

<PageTitle>Grammar reviews · KotoNeko</PageTitle>

@if (_session is null)
{
    <p class="kn-empty">Loading…</p>
}
else if (_session.Total == 0)
{
    <div class="kn-session-done">
        <div class="big">☕</div>
        <h1>No grammar reviews due</h1>
        <p>A grammar point comes up for review a few hours after its lesson, then at longer and longer gaps.</p>
        <a class="kn-btn kn-btn-primary" href="/">Back to dashboard</a>
    </div>
}
else if (_item is null)
{
    <div class="kn-session-done">
        <div class="big">🎉</div>
        <h1>Grammar reviews done</h1>
        <p>
            @_session.Passed of @_session.Reviewed passed@(_session.LeftForLater > 0 ? $"; {_session.LeftForLater} left for later (still due)" : "").
        </p>
        <a class="kn-btn kn-btn-primary" href="/">Back to dashboard</a>
    </div>
}
else
{
    GrammarPoint point = _item.Point;
    GrammarListEntry entry = point.Entry!;
    ContrastChoice? contrast = _item.Contrast;
    <div class="kn-lesson">
        <p class="kn-hint">Grammar review @(_session.Total - _session.Remaining + 1) of @_session.Total · @SrsSchedule.DisplayName(_stage)</p>
        <div class="kn-lesson-head">
            <span class="kn-lesson-pattern">@entry.Pattern</span>
            @if (_item.Cues.Meaning)
            {
                <span class="kn-lesson-meaning">@entry.Meaning</span>
            }
            <span class="kn-pill kn-pill-jlpt">@entry.Level</span>
        </div>
        @if (_item.Cues.Formation)
        {
            <ul class="kn-lesson-formation">
                @foreach (string rule in GrammarContent.FormationRules(point.Formation))
                {
                    <li class="kn-grammar-pattern">@rule</li>
                }
            </ul>
        }

        <div class="kn-panel">
            @if (contrast is null)
            {
                <p>Write a sentence of your own with <span class="kn-grammar-pattern">@entry.Pattern</span>. Anything you like.</p>
            }
            else
            {
                <p>
                    Write two sentences of your own: one with <span class="kn-grammar-pattern">@entry.Pattern</span>, and one with
                    the similar <span class="kn-grammar-pattern">@contrast.Pattern</span>, each where it fits. Using both shows you know the difference.
                </p>
            }
            <CompositionIdeas @key="point.Id" Ideas="point.Situations" ShowHints="_item.Cues.Formation" />
            @if (Reviews.Route is not { IsConfigured: true })
            {
                <div class="kn-msg kn-msg-err">No grader is configured (Llm:Jobs:Grade), so reviews can't be checked. Set it up and come back; your points stay due.</div>
            }

            @if (contrast is not null)
            {
                <div class="kn-review-label">With <span class="kn-grammar-pattern">@entry.Pattern</span></div>
            }
            <JapaneseInput @ref="_input" @key="(_round, 0)" AutoFocus="true" Placeholder="Your sentence…"
                           OnChanged="t => _typed[0] = t.Text" OnSubmit="CheckAsync" />
            <label class="kn-hint kn-review-intent">
                What you mean (optional, in English): helps the grader judge your sentence as you meant it.
                <input class="kn-input" maxlength="@GrammarReviewAttempt.MaxIntentLength" @bind="_intent[0]" @bind:event="oninput"
                       disabled="@(_result is not null)" placeholder="e.g. I studied, but I still failed" />
            </label>
            @if (contrast is not null)
            {
                <div class="kn-review-label">With <span class="kn-grammar-pattern">@contrast.Pattern</span></div>
                <JapaneseInput @key="(_round, 1)" Placeholder="Your sentence with the similar point…"
                               OnChanged="t => _typed[1] = t.Text" OnSubmit="CheckAsync" />
                <label class="kn-hint kn-review-intent">
                    What you mean (optional, in English)
                    <input class="kn-input" maxlength="@GrammarReviewAttempt.MaxIntentLength" @bind="_intent[1]" @bind:event="oninput"
                           disabled="@(_result is not null)" />
                </label>
            }

            <div class="kn-toolbar">
                @if (_result is null)
                {
                    <button class="kn-btn kn-btn-primary" disabled="@(_grading || Reviews.Route is not { IsConfigured: true })" @onclick="CheckAsync">
                        @(_grading ? "Checking…" : "Check")
                    </button>
                    @if (_session.Decided is null)
                    {
                        <button class="kn-btn" disabled="@_grading" @onclick="LeaveForLaterAsync" title="Skip this point for now; it stays due">Leave for later</button>
                    }
                    else
                    {
                        <button class="kn-btn" disabled="@_grading" @onclick="NextAsync">Next</button>
                    }
                }
                else
                {
                    bool missed = _result.Sentences.Any(s => !(Disputed(s) ?? s.Final).TargetUsedCorrectly);
                    @if (missed)
                    {
                        <button class="kn-btn kn-btn-primary" disabled="@_disputeBusy" @onclick="RewriteAsync">Write another</button>
                    }
                    <button class="kn-btn @(missed ? "" : "kn-btn-primary")" disabled="@_disputeBusy" @onclick="NextAsync">Next</button>
                }
            </div>
            @if (_grading && _status is not null)
            {
                <p class="kn-hint">@_status</p>
            }
            @if (_problem is not null)
            {
                <div class="kn-msg kn-msg-err">@_problem</div>
            }
            @if (_gradeError is not null)
            {
                <div class="kn-msg kn-msg-err">
                    Your sentence couldn't be checked: @_gradeError
                    <button class="kn-btn kn-btn-sm" disabled="@_grading" @onclick="CheckAsync">Retry</button>
                </div>
            }

            @if (_result is { } r)
            {
                @foreach (GradedSentence g in r.Sentences)
                {
                    @if (r.Sentences.Count > 1)
                    {
                        <h3>With <span class="kn-grammar-pattern">@g.Task.Pattern</span>: <span class="kn-jp">@g.Task.Sentence</span></h3>
                    }
                    <GradingVerdictView Verdict="g.Verdict" Sentence="@g.Task.Sentence" />
                    @if (g.Second is { } second)
                    {
                        <p class="kn-hint">The grader wasn't sure, so a second grader (@g.SecondModel) checked it independently:</p>
                        <GradingVerdictView Verdict="second" Sentence="@g.Task.Sentence" />
                    }
                    @if (g.SecondProblem is not null)
                    {
                        <p class="kn-hint">@g.SecondProblem</p>
                    }
                    @if (_dispute?.Rechecked.FirstOrDefault(d => d.Sentence.AttemptId == g.AttemptId) is { } disputed)
                    {
                        <p class="kn-hint">Your dispute: a second grader (@disputed.Model) looked again:</p>
                        <GradingVerdictView Verdict="disputed.Verdict" Sentence="@g.Task.Sentence" />
                    }
                    <WhyQuestions @key="(g.AttemptId, _dispute is null)" Graded="g.Task" Verdict="Disputed(g) ?? g.Final" />
                }

                <p class="kn-review-effect">@(ReferenceEquals(r, _deciding) && _dispute is { Overturned: true } d ? d.Note : Effect(r))</p>
                @if (ReferenceEquals(r, _deciding) && _dispute is { Overturned: false } upheld)
                {
                    <p class="kn-hint">@upheld.Note</p>
                }
                @if (r.SavedNote is not null)
                {
                    <p class="kn-hint">@r.SavedNote</p>
                }
                @if (contrast is not null && contrast.Difference.Length > 0)
                {
                    <p class="kn-hint">How <span class="kn-grammar-pattern">@entry.Pattern</span> and <span class="kn-grammar-pattern">@contrast.Pattern</span> differ: @contrast.Difference</p>
                }

                @if (_item.Earlier.Count > 0)
                {
                    <h3>Your earlier sentences with @entry.Pattern</h3>
                    <ul class="kn-review-earlier">
                        @foreach (string sentence in _item.Earlier.Take(8))
                        {
                            <li class="kn-jp">@sentence</li>
                        }
                    </ul>
                }
            }

            @* The review's miss can be disputed until Next, practice rewrites or not. *@
            @if (_deciding is { Effect: GrammarReviewEffect.Dropped or GrammarReviewEffect.Kept } && Reviews.RecheckRoute is { IsConfigured: true } recheck)
            {
                <div class="kn-review-dispute">
                    @if (_dispute is { } done)
                    {
                        @if (!ReferenceEquals(_result, _deciding))
                        {
                            <span class="kn-hint">Your dispute: @done.Note</span>
                        }
                    }
                    else if (!_disputing)
                    {
                        <button class="kn-btn kn-btn-sm" @onclick="() => _disputing = true">Dispute this verdict</button>
                        <span class="kn-hint">Think it's right? A second grader (@recheck.Model) takes a fresh look; if it agrees with you, this review counts as a pass.</span>
                    }
                    else
                    {
                        <label class="kn-hint">
                            Why you think it's right (optional): what you meant, or why you wrote it this way.
                            <textarea class="kn-textarea" rows="2" maxlength="@GrammarReviewAttempt.MaxIntentLength" @bind="_disputeComment" disabled="@_disputeBusy"></textarea>
                        </label>
                        <div class="kn-toolbar">
                            <button class="kn-btn kn-btn-primary kn-btn-sm" disabled="@_disputeBusy" @onclick="DisputeAsync">
                                @(_disputeBusy ? "Asking the second grader…" : "Ask a second grader")
                            </button>
                            <button class="kn-btn kn-btn-sm" disabled="@_disputeBusy" @onclick="() => _disputing = false">Cancel</button>
                        </div>
                    }
                    @if (_disputeError is not null)
                    {
                        <div class="kn-msg kn-msg-err">@_disputeError</div>
                    }
                </div>
            }
        </div>
        <div class="kn-toolbar">
            <a class="kn-btn" href="/grammar/point/@point.Id">This point's lesson</a>
        </div>
    </div>
}

@code {
    private TutorSession? _session;
    private GrammarReviewItem? _item;
    private SrsStage _stage;

    private JapaneseInput? _input;
    private int _round;
    private readonly string[] _typed = { "", "" };
    private readonly string[] _intent = { "", "" };
    private bool _grading;
    private string? _status;
    private GrammarReviewResult? _result;

    /// <summary>The graded answer that decided this point's review; practice rewrites don't replace it.</summary>
    private GrammarReviewResult? _deciding;
    private string? _problem;
    private string? _gradeError;

    private bool _disputing;
    private bool _disputeBusy;
    private string _disputeComment = "";
    private DisputeResult? _dispute;
    private string? _disputeError;

    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _session = await Reviews.StartAsync(DateTime.UtcNow);
        await LoadCurrentAsync();
    }

    /// <summary>Show the session's current point, skipping any that have gone (deleted, or no longer learned).</summary>
    private async Task LoadCurrentAsync()
    {
        _item = null;
        while (_session!.Current is int id) {
            if (await Reviews.GetAsync(id) is { } item) {
                _item = item;
                _stage = item.Point.Srs!.Stage;
                break;
            }
            _session.LeaveForLater();
        }
        _deciding = null;
        _disputing = false;
        _disputeComment = "";
        _dispute = null;
        _disputeError = null;
        ResetRound();
    }

    private void ResetRound()
    {
        _round++;
        _typed[0] = _typed[1] = "";
        _intent[0] = _intent[1] = "";
        _result = null;
        _problem = null;
        _gradeError = null;
        _status = null;
    }

    /// <summary>A sentence's verdict from a dispute, when it was disputed.</summary>
    private GradingVerdict? Disputed(GradedSentence g) =>
        _dispute?.Rechecked.FirstOrDefault(d => d.Sentence.AttemptId == g.AttemptId)?.Verdict;

    private async Task CheckAsync()
    {
        if (_session is null || _item is null || _grading || _result is not null) {
            return;
        }
        List<ReviewSentenceInput> inputs = new() { new ReviewSentenceInput(_typed[0], _intent[0]) };
        if (_item.Contrast is not null) {
            inputs.Add(new ReviewSentenceInput(_typed[1], _intent[1]));
        }
        if (inputs.All(i => GrammarContent.CleanSentence(i.Sentence).Length == 0)) {
            return;
        }
        _grading = true;
        _status = null;
        _problem = null;
        _gradeError = null;
        StateHasChanged();
        try {
            (GrammarReviewResult? result, string? problem) = await Reviews.GradeAsync(_session, _item, inputs, async () => {
                _status = "The grader wasn't sure, so a second grader is taking a look. This can take a little while…";
                await InvokeAsync(StateHasChanged);
            }, _cts.Token);
            _problem = problem;
            _result = result;
            if (result is { Effect: not GrammarReviewEffect.Practice }) {
                _deciding = result;
            }
        } catch (LlmException ex) {
            _gradeError = ex.Message;
        } catch (OperationCanceledException) {
            return;
        } finally {
            _grading = false;
            _status = null;
        }
    }

    private async Task DisputeAsync()
    {
        if (_session is null || _item is null || _deciding is null || _disputeBusy) {
            return;
        }
        _disputeBusy = true;
        _disputeError = null;
        try {
            _dispute = await Reviews.DisputeAsync(_session, _item.Point.Id, _deciding, _disputeComment, _cts.Token);
            _disputing = false;
        } catch (LlmException ex) {
            _disputeError = $"The second grader couldn't be asked: {ex.Message} Nothing has changed; try again.";
        } catch (OperationCanceledException) {
            return;
        } finally {
            _disputeBusy = false;
        }
    }

    /// <summary>After a miss: fresh sentences, as practice (the review is already decided).</summary>
    private async Task RewriteAsync()
    {
        ResetRound();
        await Task.Yield();
        if (_input is not null) {
            await _input.FocusAsync();
        }
    }

    private async Task NextAsync()
    {
        if (_session!.Next()) {
            await LoadCurrentAsync();
        }
    }

    private async Task LeaveForLaterAsync()
    {
        if (_session!.LeaveForLater()) {
            await LoadCurrentAsync();
        }
    }

    private static string Effect(GrammarReviewResult r) => r.Effect switch {
        GrammarReviewEffect.Advanced => $"Counted as a pass: {SrsSchedule.DisplayName(r.StageBefore)} → {SrsSchedule.DisplayName(r.StageAfter)}.",
        GrammarReviewEffect.Dropped => (r.StageBefore == r.StageAfter
                ? $"Counted as a miss: the point stays at {SrsSchedule.DisplayName(r.StageAfter)}, the first stage, and comes back in a few hours."
                : $"Counted as a miss: {SrsSchedule.DisplayName(r.StageBefore)} → {SrsSchedule.DisplayName(r.StageAfter)}.")
            + " Write another sentence to practise; it won't change the stage.",
        GrammarReviewEffect.Kept => $"Not sure enough to count: the point stays at {SrsSchedule.DisplayName(r.StageAfter)} and comes back at the same stage. Write another sentence to practise.",
        _ => "Practice: the review was already decided, so this doesn't change the stage.",
    };

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}

@page "/settings"
@inject SettingsService SettingsService
@inject DictionaryService DictionaryService
@inject DictionaryImportService ImportService
@inject BackupService Backups
@implements IDisposable
@using KotoNeko.Data.Dictionary
@using KotoNeko.Data.Backup
@using KotoNeko.Core.Srs

<PageTitle>Settings · KotoNeko</PageTitle>

<h1>Settings</h1>

@if (_message is not null)
{
    <div class="kn-msg kn-msg-ok">@_message</div>
}

@if (_settings is null)
{
    <p class="kn-empty">Loading…</p>
}
else
{
    <div class="kn-panel">
        <h2>Daily budget</h2>
        <p class="kn-hint">Caps limit new work only. Reviews that are due always run: holding them back would build a backlog.</p>
        <div class="kn-grid-2">
            <div class="kn-form-row">
                <label>Study minutes per day</label>
                <input class="kn-input" type="number" min="5" max="600" @bind="_settings.DailyMinutesTarget" />
            </div>
            <div class="kn-form-row">
                <label>New vocabulary lessons per day (0 pauses lessons)</label>
                <input class="kn-input" type="number" min="0" max="500" @bind="_settings.DailyLessonCap" />
            </div>
            <div class="kn-form-row">
                <label>Items per lesson session</label>
                <input class="kn-input" type="number" min="1" max="50" @bind="_settings.LessonBatchSize" />
            </div>
            <div class="kn-form-row">
                <label>Dictation sentences per day (0 pauses dictation)</label>
                <input class="kn-input" type="number" min="0" max="200" @bind="_settings.DailyDictationCap" />
            </div>
        </div>
    </div>

    <div class="kn-panel">
        <h2>Listening</h2>
        <div class="kn-form-row">
            <label style="display:flex;align-items:center;gap:0.4rem">
                <input type="checkbox" @bind="_settings.ListeningEnabled" />
                Ask a listening question in reviews (hear the word, type its meaning)
            </label>
        </div>
        <div class="kn-form-row">
            <label style="display:flex;align-items:center;gap:0.4rem">
                <input type="checkbox" @bind="_settings.ListeningCountsTowardSrs" disabled="@(!_settings.ListeningEnabled)" />
                Listening misses count toward the SRS stage
            </label>
            <p class="kn-hint">Off: listening misses are logged for your stats but never drop an item, like conjugation.</p>
        </div>

        <h2>Speech generation speed</h2>
        <div class="kn-form-row">
            <label>Default speed for new speech audio</label>
            <select class="kn-select" @bind="_settings.SpeechSpeed">
                @foreach (SpeechSpeed speed in Enum.GetValues<SpeechSpeed>())
                {
                    <option value="@speed">@speed.Label()</option>
                }
            </select>
            <p class="kn-hint">Audio always plays at the speed it was generated at. You can pick a different speed each time you fetch speech on the vocabulary page.</p>
        </div>
    </div>

    <div class="kn-panel">
        <h2>Known words</h2>
        <div class="kn-form-row">
            <label>A word you're studying counts as known from</label>
            <select class="kn-select" style="max-width:200px" @bind="_settings.KnownWordStage">
                @foreach (SrsStage stage in StudySettings.KnownWordStages)
                {
                    <option value="@stage">@SrsSchedule.DisplayName(stage)</option>
                }
            </select>
            <p class="kn-hint">
                Known words are the ones practice sentences may use and that show no furigana: words you've marked as known
                (asleep, not studied) plus words you're studying once they reach this stage. Words marked "do not use" never count.
                Manage them on the <a href="/known-words">Known words</a> page.
            </p>
        </div>
    </div>

    <div class="kn-toolbar">
        <button class="kn-btn kn-btn-primary" @onclick="SaveAsync" disabled="@_saving">Save</button>
    </div>

    <div class="kn-panel">
        <h2>Japanese input and dictionary</h2>
        <p>
            Japanese text fields convert kana to kanji themselves, offline, so keep the Windows IME off.
            <a href="/japanese-input">Try the Japanese input</a>.
        </p>
        @if (_dictionary is null)
        {
            <p><strong>No dictionary imported.</strong> Conversion offers only your vocabulary, hiragana and katakana until you import one.</p>
        }
        else
        {
            <p>
                <strong>@_dictionary.EntryCount.ToString("N0") entries</strong> from @_dictionary.Source,
                version @_dictionary.Version (@_dictionary.DictionaryDate),
                imported @_dictionary.ImportedAt.ToLocalTime().ToString("MMM d, yyyy").
            </p>
            @if (_dictionary.FormatVersion < DictionaryImport.CurrentFormatVersion)
            {
                <div class="kn-msg kn-msg-err">
                    This import is from an older version of KotoNeko. It lacks
                    @(_dictionary.FormatVersion < DictionaryImport.MeaningsFormatVersion ? "word meanings and " : "")JMdict entry numbers,
                    which filling in words from the dictionary and adding the JLPT word lists need.
                    Import it again (the button below); everything else keeps working meanwhile.
                </div>
            }
        }
        @{ DictionaryImportStatus import = ImportService.Status; }
        @if (import.Running)
        {
            <div class="kn-import-progress">
                <div><strong>Importing</strong> from @import.Source · @StageText(import)</div>
                <div class="kn-import-bar"><div class="kn-import-bar-fill" style="width:@Percent(import)%"></div></div>
                <p class="kn-hint">This runs on the server: you can leave this page and come back. The current dictionary keeps working until the new one is complete.</p>
            </div>
        }
        else
        {
            @if (import.Error is not null)
            {
                <div class="kn-msg kn-msg-err">The import from @import.Source failed: @import.Error</div>
            }
            else if (import.Result is { } done)
            {
                <div class="kn-msg kn-msg-ok">
                    Imported @done.Entries.ToString("N0") entries (JMdict @done.Version) in @done.Elapsed.TotalSeconds.ToString("N0") seconds.
                </div>
            }

            <div class="kn-toolbar">
                <button class="kn-btn kn-btn-accent" @onclick="DownloadAndImport" disabled="@_uploading">
                    ⤓ Download and import the latest dictionary
                </button>
            </div>
            <p class="kn-hint">
                Downloads the newest full English release of jmdict-simplified from GitHub (about 12 MB) and imports it,
                replacing the current dictionary. This download is the only thing KotoNeko fetches for the dictionary;
                nothing you type is sent anywhere.
            </p>

            <div class="kn-form-row">
                <label>Or import a file you already have (<code>jmdict-eng-…json.zip</code> or the unzipped <code>.json</code>)</label>
                <InputFile OnChange="UploadAndImport" accept=".zip,.json" disabled="@_uploading" />
                @if (_uploading)
                {
                    <p class="kn-hint">Uploading… @_uploadPercent%</p>
                }
            </div>
        }
        @if (_importMessage is not null)
        {
            <div class="kn-msg kn-msg-err">@_importMessage</div>
        }
        <p class="kn-hint">
            From the command line instead: <code>KotoNeko.Web --import-jmdict "path\to\jmdict-eng-&lt;version&gt;.json"</code>.
        </p>

        <h3 class="kn-subhead">Learned choices</h3>
        <p>
            When you pick a candidate other than the first, KotoNeko remembers it and offers it first next time,
            for every form of the word (picking 読んだ teaches 読む). Dictation fields don't learn and ignore what was learned,
            so they still test your kanji choice.
            <strong>@_choiceCount.ToString("N0")</strong> remembered.
        </p>
        <div class="kn-toolbar">
            <button class="kn-btn" @onclick="ForgetChoicesAsync" disabled="@(_choiceCount == 0)">Forget learned choices</button>
        </div>

        <p class="kn-hint">
            This uses the JMdict dictionary, the property of the Electronic Dictionary Research and Development Group,
            used under the Creative Commons Attribution-ShareAlike 4.0 licence (www.edrdg.org/edrdg/licence.html).
        </p>
    </div>

    <div class="kn-panel">
        <h2>Backups</h2>
        @if (Backups.Problem is string problem)
        {
            <div class="kn-msg kn-msg-err">@problem</div>
        }
        else
        {
            BackupStatus backup = Backups.Status;
            <p>
                Backs up the whole database (gzipped SQL) into <code>@Backups.Folder</code>.
                KotoNeko also backs up automatically before it applies a database migration at startup.
            </p>
            <div class="kn-toolbar">
                <button class="kn-btn kn-btn-accent" @onclick="BackUpNow" disabled="@backup.Running">
                    @(backup.Running ? "Backing up…" : "Back up now")
                </button>
            </div>
            @if (backup.Error is not null)
            {
                <div class="kn-msg kn-msg-err">The backup failed: @backup.Error</div>
            }
            else if (backup.Last is { } last && !backup.Running)
            {
                <div class="kn-msg kn-msg-ok">Backed up to @last.Name (@Megabytes(last.Size)).</div>
            }

            @if (_backups.Count == 0)
            {
                <p class="kn-empty">No backups yet.</p>
            }
            else
            {
                <table class="kn-table">
                    <thead><tr><th>Backup</th><th>Made</th><th>Size</th></tr></thead>
                    <tbody>
                        @foreach (BackupFile file in _backups.Take(15))
                        {
                            <tr>
                                <td><code>@file.Name</code></td>
                                <td>@file.CreatedAt.ToString("MMM d, yyyy HH:mm")</td>
                                <td>@Megabytes(file.Size)</td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (_backups.Count > 15)
                {
                    <p class="kn-hint">…and @(_backups.Count - 15) older. Old backups are never deleted automatically.</p>
                }
                else
                {
                    <p class="kn-hint">Old backups are never deleted automatically.</p>
                }
            }

            <p class="kn-hint">
                To restore one, stop KotoNeko and run this from the repository root (Git Bash), with the backup's name.
                It replaces every table in <code>@Backups.Database</code> with the backup's copy:
            </p>
            <pre class="kn-code">gunzip -c "backups/@(_backups.FirstOrDefault()?.Name ?? "kotoneko-….sql.gz")" | "@MysqlPath" -u YOUR_USER -p @Backups.Database</pre>
        }
    </div>
}

@code {
    private StudySettings? _settings;
    private DictionaryImport? _dictionary;
    private string? _message;
    private bool _saving;
    private bool _uploading;
    private int _uploadPercent;
    private string? _importMessage;
    private bool _wasRunning;
    private int _choiceCount;
    private List<BackupFile> _backups = new();

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsService.GetAsync();
        _dictionary = await DictionaryService.GetImportAsync();
        _choiceCount = await DictionaryService.CountChoicesAsync();
        _wasRunning = ImportService.Status.Running;
        ImportService.Changed += OnImportChanged;
        _backups = Backups.List();
        Backups.Changed += OnBackupChanged;
    }

    // The import runs on a background thread; redraw on this page's dispatcher, and
    // reload the dictionary details once a running import finishes.
    private void OnImportChanged() => _ = InvokeAsync(async () =>
    {
        bool running = ImportService.Status.Running;
        if (_wasRunning && !running) {
            _dictionary = await DictionaryService.GetImportAsync();
        }
        _wasRunning = running;
        StateHasChanged();
    });

    private async Task ForgetChoicesAsync()
    {
        await DictionaryService.ForgetChoicesAsync();
        _choiceCount = 0;
    }

    private void DownloadAndImport()
    {
        _importMessage = ImportService.StartDownloadAndImport() ? null : "An import is already running.";
    }

    private async Task UploadAndImport(InputFileChangeEventArgs e)
    {
        _importMessage = null;
        IBrowserFile file = e.File;
        string extension = Path.GetExtension(file.Name).ToLowerInvariant();
        if (extension is not (".zip" or ".json")) {
            _importMessage = "Choose the dictionary's .zip or .json file.";
            return;
        }

        // Copy the upload to a temporary file first: the import itself runs in the
        // background, after this page's connection may be gone.
        string temp = Path.Combine(Path.GetTempPath(), $"kotoneko-upload-{Guid.NewGuid():N}{extension}");
        _uploading = true;
        try {
            await using (Stream source = file.OpenReadStream(JmdictFiles.MaxFileSize))
            await using (FileStream target = File.Create(temp)) {
                byte[] buffer = new byte[256 * 1024];
                long done = 0;
                int read;
                while ((read = await source.ReadAsync(buffer)) > 0) {
                    await target.WriteAsync(buffer.AsMemory(0, read));
                    done += read;
                    int percent = file.Size > 0 ? (int)(100 * done / file.Size) : 0;
                    if (percent != _uploadPercent) {
                        _uploadPercent = percent;
                        StateHasChanged();
                    }
                }
            }

            if (!ImportService.StartImportFromFile(temp, file.Name)) {
                _importMessage = "An import is already running.";
            }
        } catch (Exception ex) {
            File.Delete(temp);
            _importMessage = $"The upload failed: {ex.Message}";
        } finally {
            _uploading = false;
            _uploadPercent = 0;
        }
    }

    private static int Percent(DictionaryImportStatus s) =>
        s.Total > 0 ? (int)Math.Clamp(100 * s.Done / s.Total, 0, 100) : 0;

    private static string StageText(DictionaryImportStatus s) => s.Stage switch
    {
        ImportStage.Downloading => $"downloading ({s.Done / (1024 * 1024)} of {Math.Max(1, s.Total / (1024 * 1024))} MB)",
        ImportStage.Reading => $"reading the dictionary ({Percent(s)}%)",
        ImportStage.Writing => $"writing entries ({s.Done:N0} of {s.Total:N0})",
        ImportStage.Done => "finishing",
        _ => "starting",
    };

    private void BackUpNow() => Backups.Start();

    // Backups run on a background thread; refresh the list when one finishes.
    private void OnBackupChanged() => _ = InvokeAsync(() =>
    {
        if (!Backups.Status.Running) {
            _backups = Backups.List();
        }
        StateHasChanged();
    });

    /// <summary>The mysql client next to mysqldump, written the Git Bash way.</summary>
    private string MysqlPath
    {
        get {
            string? folder = Path.GetDirectoryName(Backups.Mysqldump);
            string mysql = folder is null ? "mysql" : Path.Combine(folder, "mysql.exe");
            return mysql.Length > 2 && mysql[1] == ':'
                ? "/" + char.ToLowerInvariant(mysql[0]) + mysql[2..].Replace('\\', '/')
                : mysql;
        }
    }

    private static string Megabytes(long bytes) => bytes < 1024 * 1024
        ? $"{Math.Max(1, bytes / 1024)} KB"
        : $"{bytes / (1024.0 * 1024.0):N1} MB";

    public void Dispose()
    {
        ImportService.Changed -= OnImportChanged;
        Backups.Changed -= OnBackupChanged;
    }

    private async Task SaveAsync()
    {
        if (_settings is null) {
            return;
        }

        _saving = true;
        try {
            await SettingsService.SaveAsync(_settings);
            // Reload so the form shows any values that were clamped on save.
            _settings = await SettingsService.GetAsync();
            _message = "Settings saved.";
        } finally {
            _saving = false;
        }
    }
}

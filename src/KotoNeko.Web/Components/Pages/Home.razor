@page "/"
@inject DashboardService Dashboard

<PageTitle>KotoNeko</PageTitle>

@if (_dbError is not null)
{
    <div class="kn-panel">
        <h2>Database not ready</h2>
        <p>KotoNeko couldn't reach its database. Set a valid MySQL connection string and reload.</p>
        <p class="kn-hint">Edit <code>appsettings.json</code> → <code>ConnectionStrings:KotoNeko</code>, or set the
            <code>KOTONEKO_CONNECTION</code> environment variable. The schema is created automatically on startup.</p>
        <pre style="background:#f6f6f6;padding:0.75rem;border-radius:4px;overflow:auto">@_dbError</pre>
    </div>
}
else if (_summary is null)
{
    <p class="kn-empty">Loading…</p>
}
else
{
    <div class="kn-cta-row">
        <a class="kn-cta kn-cta-lessons @(_summary.LessonsOpenNow == 0 ? "kn-cta-disabled" : "")" href="/lessons">
            <div class="kn-cta-count">@_summary.LessonsOpenNow</div>
            <div class="kn-cta-label">
                Lessons
                @if (_summary.LessonsAvailable > _summary.LessonsOpenNow)
                {
                    <span>· daily cap (@_summary.LessonsAvailable waiting)</span>
                }
            </div>
        </a>
        <a class="kn-cta kn-cta-grammar @(_summary.GrammarLessonsOpenNow == 0 ? "kn-cta-disabled" : "")" href="/grammar-lessons">
            <div class="kn-cta-count">@_summary.GrammarLessonsOpenNow</div>
            <div class="kn-cta-label">
                Grammar lessons
                @if (_summary.GrammarLessonsAvailable > _summary.GrammarLessonsOpenNow)
                {
                    <span>· daily cap (@_summary.GrammarLessonsAvailable waiting)</span>
                }
            </div>
        </a>
        <a class="kn-cta kn-cta-reviews @(_summary.DueNow == 0 ? "kn-cta-disabled" : "")" href="/reviews">
            <div class="kn-cta-count">@_summary.DueNow</div>
            <div class="kn-cta-label">Reviews</div>
        </a>
    </div>

    <div class="kn-panel">
        <h2>SRS progress</h2>
        <div class="kn-bands">
            <div class="kn-band kn-band-apprentice">
                <div class="kn-band-count">@_summary.BandCounts["Apprentice"]</div>
                <div class="kn-band-name">Apprentice</div>
            </div>
            <div class="kn-band kn-band-guru">
                <div class="kn-band-count">@_summary.BandCounts["Guru"]</div>
                <div class="kn-band-name">Guru</div>
            </div>
            <div class="kn-band kn-band-master">
                <div class="kn-band-count">@_summary.BandCounts["Master"]</div>
                <div class="kn-band-name">Master</div>
            </div>
            <div class="kn-band kn-band-enlightened">
                <div class="kn-band-count">@_summary.BandCounts["Enlightened"]</div>
                <div class="kn-band-name">Enlightened</div>
            </div>
            <div class="kn-band kn-band-burned">
                <div class="kn-band-count">@_summary.BandCounts["Burned"]</div>
                <div class="kn-band-name">Burned</div>
            </div>
        </div>
    </div>

    <div class="kn-panel">
        <h2>Listening</h2>
        <div class="kn-accuracy-row">
            <div class="kn-accuracy kn-accuracy-ear">
                <div class="kn-accuracy-value">@Percent(_summary.ByEar)</div>
                <div class="kn-accuracy-name">By ear</div>
            </div>
            <div class="kn-accuracy kn-accuracy-sight">
                <div class="kn-accuracy-value">@Percent(_summary.BySight)</div>
                <div class="kn-accuracy-name">By sight</div>
            </div>
        </div>
        <p class="kn-hint">Accuracy over the last 30 days. By ear is the listening question; by sight is meaning, reading and production.</p>

        <h3 class="kn-subhead">Known by sight, not yet by ear</h3>
        @if (_summary.EarGaps.Count == 0)
        {
            <p class="kn-empty">No gaps yet. Words you read well but miss by ear will show up here.</p>
        }
        else
        {
            <ul class="kn-missed-list">
                @foreach (EarGapItem item in _summary.EarGaps)
                {
                    <li class="kn-missed-item">
                        <span class="kn-missed-jp kn-jp">@item.Japanese</span>
                        <span class="kn-missed-reading">@item.Reading</span>
                        <span class="kn-missed-meaning">@item.Meaning</span>
                        <span class="kn-missed-tag">sight @item.SightPercent% · ear @item.EarPercent%</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="kn-panel">
        <h2>Needs a practice sentence</h2>
        @if (_summary.NeedsSentenceCount == 0)
        {
            <p class="kn-empty">Every word you're studying has a practice sentence listening can use.</p>
        }
        else
        {
            <p class="kn-hint">
                @_summary.NeedsSentenceCount word@(_summary.NeedsSentenceCount == 1 ? "" : "s") you're studying
                @(_summary.NeedsSentenceCount == 1 ? "has" : "have") no short, voiced practice sentence made only of words you know,
                so listening plays the word alone. Due soonest first:
            </p>
            <ul class="kn-missed-list">
                @foreach (NeedsSentenceItem item in _summary.NeedsSentence)
                {
                    <li class="kn-missed-item">
                        <a class="kn-missed-jp kn-jp" href="/vocab/@item.VocabularyId">@item.Japanese</a>
                        <span class="kn-missed-reading">@item.Reading</span>
                        <span class="kn-missed-meaning">@item.Meaning</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="kn-panel">
        <h2>Upcoming reviews</h2>
        @if (_summary.UpcomingSessions.Count == 0)
        {
            <p class="kn-sessions-empty">No upcoming reviews scheduled.</p>
        }
        else
        {
            <ul class="kn-sessions-list">
                @foreach (UpcomingSession session in _summary.UpcomingSessions)
                {
                    DateTime availableAt = session.AvailableAt.ToLocalTime();
                    <li class="kn-session-row">
                        <span class="kn-session-time">@availableAt.ToString("ddd, MMM d · HH:mm")</span>
                        <span class="kn-session-count">@session.Count item@(session.Count == 1 ? "" : "s")</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="kn-panel">
        <h2>Recently missed</h2>
        @if (_summary.RecentlyMissed.Count == 0)
        {
            <p class="kn-empty">Nothing missed recently. 🎉</p>
        }
        else
        {
            <ul class="kn-missed-list">
                @foreach (MissedItem item in _summary.RecentlyMissed)
                {
                    <li class="kn-missed-item">
                        <span class="kn-missed-jp kn-jp">@item.Japanese</span>
                        <span class="kn-missed-reading">@item.Reading</span>
                        <span class="kn-missed-meaning">@item.Meaning</span>
                        <span class="kn-missed-tag">@item.QuestionType</span>
                    </li>
                }
            </ul>
        }
    </div>

    <div class="kn-panel">
        <h2>Library</h2>
        <p style="color:#666">
            @_summary.TotalItems total items · @_summary.AsleepItems asleep ·
            <a href="/vocab">manage vocabulary</a>
        </p>
    </div>
}

@code {
    private DashboardSummary? _summary;
    private string? _dbError;

    private static string Percent(Accuracy a) => a.Percent is int p ? $"{p}%" : "—";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _summary = await Dashboard.GetSummaryAsync(DateTime.UtcNow);
        }
        catch (Exception ex)
        {
            _dbError = ex.Message;
        }
    }
}
